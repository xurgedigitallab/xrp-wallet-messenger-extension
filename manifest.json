{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://bidds.com/*",
    "https://xrp.cafe/*",
    "https://xmart.art/*",
    "https://xrpnft.com/*",
    "http://localhost:3000/*",
    "https://3db0f9ff-0403-42b3-91cf-d9f6166dabbf-00-z920vd7lo1bb.spock.replit.dev:3000/"
  ],
  "background": {
    "service_worker": "dist/background.bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/button_icon.svg",
        "options.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:3000 ws://localhost:3000 wss://*.quiknode.pro https://3db0f9ff-0403-42b3-91cf-d9f6166dabbf-00-z920vd7lo1bb.spock.replit.dev:3000"
  }
}